{
  "name": "@howlerops/valhalla",
  "version": "0.4.0",
  "description": "HowlerOps Valhalla: OpenCode plugins and Pi resources for planning, execution, research, review, and orchestration.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlerops/valhalla.git"
  },
  "bugs": {
    "url": "https://github.com/howlerops/valhalla/issues"
  },
  "homepage": "https://github.com/howlerops/valhalla#readme",
  "main": "./src/index.mjs",
  "bin": {
    "opencode-agentic-commands": "./scripts/install-opencode.mjs",
    "opencode-agentic-commands-install": "./scripts/install-opencode.mjs",
    "valhalla": "./scripts/install-opencode.mjs",
    "valhalla-install": "./scripts/install-opencode.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./tyr": "./src/tyr.mjs",
    "./munin": "./src/munin.mjs",
    "./eitri": "./src/eitri.mjs",
    "./vidar": "./src/vidar.mjs",
    "./hugin": "./src/hugin.mjs",
    "./skuld": "./src/skuld.mjs",
    "./polaris": "./src/polaris.mjs",
    "./vegvisir": "./src/vegvisir.mjs"
  },
  "files": [
    "src",
    "pi",
    "docs",
    "scripts/install-opencode.mjs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "prompts": [
      "./pi/prompts"
    ],
    "skills": [
      "./pi/skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/opencode-plugin.test.mjs && node test/install-opencode.test.mjs && node test/pi-harness.test.mjs && node test/package-docs.test.mjs"
  },
  "keywords": [
    "opencode",
    "pi-package",
    "pi-skill",
    "tyr",
    "munin",
    "eitri",
    "vidar",
    "hugin",
    "skuld",
    "polaris",
    "vegvisir",
    "agentic"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@opencode-ai/plugin": "1.18.30"
  }
}
